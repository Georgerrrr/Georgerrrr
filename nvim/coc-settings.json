{
"suggest.enablePreselect": false,
"inlayHints.enable": true,
"inlayHints.enableParameter": true,
"clangd.arguments": [
  "--inlay-hints=true"
],
"languageserver": {
  "ccls": {
    "command": "ccls",
    "filetypes": ["c", "cc", "cpp", "c++", "objc", "objcpp"],
    "rootPatterns": [".ccls", "compile_commands.json", ".git/", ".hg/"],
    "initializationOptions": {
        "cache": {
          "directory": "/tmp/ccls"
        }
      }
  }
}
}
